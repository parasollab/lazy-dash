+        out.center /= static_cast<S>(prims.size());
+        out.radius = 0;
+        for (std::size_t k = 0; k < prims.size(); ++k)
+            out.radius = std::max(out.radius, (centers[k] - out.center).norm() + prims[k].geom->aabb_radius);
+    }
