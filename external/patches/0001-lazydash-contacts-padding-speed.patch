+    /// A robot posed once: world transform of every primitive and the
+    /// bounding sphere, shared by all pair checks at one timestep.
+    struct PosedRobot {
+        const RobotPrimCache *cache = nullptr;
+        std::vector<Transform3> world;
+        Vector3 center = Vector3::Zero();
+        S radius = 0;
+    };
+
+    void poseRobot(const RobotModel &robot, const std::vector<double> &config,
+                   PosedRobot &out) const {
+        out.cache = &robotCache(robot);
+        const auto &prims = out.cache->prims;
+        out.world.resize(prims.size());
+        if (prims.empty())
+            return;
+        const auto link_tf = robot.getLinkTransforms(config);
+        out.center = Vector3::Zero();
+        std::vector<Vector3> centers(prims.size());
+        for (std::size_t k = 0; k < prims.size(); ++k) {
+            out.world[k] = eigenAffineToFcl(link_tf[static_cast<std::size_t>(prims[k].link_index)]) *
+                           prims[k].tf_link;
+            centers[k] = out.world[k] * prims[k].geom->aabb_center;
+            out.center += centers[k];
