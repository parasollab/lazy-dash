     std::vector<ObstacleCylinder> env_cylinders_;
     std::vector<CollisionGeometryPtr> env_geoms_;
     std::vector<Transform3> env_transforms_;
+    // Per environment geometry: its axis segment (centre, unit axis, half
+    // length) and radius as a capsule that contains it (a sphere: length 0).
+    // Thin long cylinders (shelf boards, wall plates) have bounding spheres
+    // far larger than themselves; the capsule test culls those pairs exactly.
+    struct EnvCapsule {
+        Vector3 center, axis;
+        S half = 0, radius = 0;
+    };
+    std::vector<EnvCapsule> env_capsules_;
+
+    /// A primitive at `world` cannot touch environment geometry `e`.
+    bool envApart(const GeomPrim &prim, const Transform3 &world, std::size_t e) const {
+        const auto &c = env_capsules_[e];
+        const Vector3 p = world * prim.geom->aabb_center - c.center;
+        const S t = std::clamp(p.dot(c.axis), -c.half, c.half);
+        const S reach = c.radius + prim.geom->aabb_radius;
+        return (p - t * c.axis).squaredNorm() > reach * reach;
+    }
