+// Geometries must come from prepareGeometry().
+// Building an fcl::CollisionObject per test recomputes it from every mesh
+// vertex, which dominated the cost of a check; the geometry-level collide()
+// does not. A bounding-sphere test skips pairs that are far apart.
+/// World bounding sphere of a robot's primitives at the given link transforms.
+static std::pair<Vector3, S> robotBounds(const std::vector<GeomPrim> &prims,
+                                         const std::vector<Eigen::Affine3d> &link_tf) {
+    Vector3 c = Vector3::Zero();
+    std::vector<Vector3> centers;
+    centers.reserve(prims.size());
+    for (const auto &prim : prims) {
+        const Transform3 T = eigenAffineToFcl(link_tf[static_cast<std::size_t>(prim.link_index)]) * prim.tf_link;
+        centers.push_back(T * prim.geom->aabb_center);
+        c += centers.back();
+    }
+    c /= static_cast<S>(prims.size());
+    S r = 0;
+    for (std::size_t i = 0; i < prims.size(); ++i)
+        r = std::max(r, (centers[i] - c).norm() + prims[i].geom->aabb_radius);
+    return {c, r};
+}
+
+/// Two robots whose bounding spheres are apart cannot collide.
+static bool robotsApart(const std::vector<GeomPrim> &pa, const std::vector<Eigen::Affine3d> &tfa,
+                        const std::vector<GeomPrim> &pb, const std::vector<Eigen::Affine3d> &tfb) {
+    const auto [ca, ra] = robotBounds(pa, tfa);
+    const auto [cb, rb] = robotBounds(pb, tfb);
+    return (ca - cb).squaredNorm() > (ra + rb) * (ra + rb);
+}
